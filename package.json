{
  "name": "dsh-flash-notify",
  "version": "1.0.2",
  "description": "Taskbar flash reminder for DeepSeek Harness: the taskbar button flashes when a turn finishes and goes dark the moment you click back in. No daemon, no auto-start.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "install.ps1",
    "src",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://codeload.github.com/246837984/D1/tar.gz/refs/heads/main",
      "zip": "https://codeload.github.com/246837984/D1/zip/refs/heads/main",
      "git": "https://github.com/246837984/D1.git"
    }
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0-0"
  },
  "scripts": {
    "test": "node --test",
    "market": "node scripts/build-market-index.mjs",
    "verify:market": "node scripts/verify-market-index.mjs",
    "build:win32": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-win32-helper.ps1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "taskbar",
    "flash",
    "notification",
    "desktop-notification",
    "productivity"
  ],
  "author": "246837984",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/246837984/D1.git"
  },
  "homepage": "https://github.com/246837984/D1#readme",
  "bugs": {
    "url": "https://github.com/246837984/D1/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dshTarget": "0.2.1-rc.2"
}
